# ───────── Grok Bot – konfiguracja (skopiuj do .env) ─────────

# Serwer
PORT=8080
# Hasło do panelu – WYMAGANE, gdy panel jest wystawiony do internetu (NODE_ENV=production)
DASHBOARD_PASSWORD=zmien-mnie-na-dlugie-haslo
# Opcjonalny sekret do podpisywania ciasteczek sesji (domyślnie wyprowadzany z hasła)
SESSION_SECRET=
# Ścieżka bazy SQLite (w Dockerze: /data/grokbot.db na wolumenie)
DB_PATH=./data/grokbot.db
# Domena dla Caddy (tylko docker-compose na VPS)
DOMAIN=bot.twojadomena.pl

# Tryb handlu: paper (domyślnie). "live" to tylko zaślepka: wymaga LIVE_CONFIRM
# i drugiego potwierdzenia w panelu, a i tak niczego nie podpisuje ani nie wysyła.
TRADING_MODE=paper
LIVE_CONFIRM=

# Jupiter Swap API v2 – darmowy klucz z https://developers.jup.ag/portal (1 req/s).
# Bez klucza: tryb keyless 0.5 req/s, a gdy Jupiter nie odpowie – symulowane wypełnienie.
JUP_API_KEY=

# Kapitał i rozmiar pozycji
START_EQUITY=150
MAX_POSITION_PCT=8
MAX_OPEN_POSITIONS=3
TOKEN_COOLDOWN_MIN=30

# Filter (8 reguł + "already pumped")
FILTER_MIN_LIQ_USD=40000
FILTER_MIN_VOL_USD=50000
# okno wolumenu: m5 | h1 | h6 | h24
FILTER_VOL_WINDOW=h1
FILTER_MIN_LP_LOCKED_PCT=90
FILTER_MAX_TOP10_PCT=25
FILTER_MAX_DEV_PCT=3
FILTER_MAX_BUNDLE_PCT=10
FILTER_MAX_H1_CHANGE_PCT=80
# ile minut nowy token może "dorastać" do progów płynności/wolumenu
FILTER_WATCH_WINDOW_MIN=20

# Analyst
ANALYST_MIN_SCORE=70

# Risk
RISK_STOP_LOSS_PCT=6
RISK_TRAIL_ACTIVATE_PCT=12
RISK_TRAIL_PCT=6
# 0 = wyłączony
RISK_TIME_STOP_MIN=45
PRIORITY_FEE_SOL=0.0001

# Częstotliwość odpytywania (ms) – zgodnie z limitami API
SCOUT_GT_POLL_MS=8000
SCOUT_DS_POLL_MS=15000
MARKET_POLL_MS=8000
RISK_POLL_MS=2500
RUGCHECK_RPS=2

# Nagrywanie danych do `npm run replay` (gzip, ~30–40 MB/dobę; najstarsze pliki kasowane powyżej limitu)
RECORD=true
RECORD_DIR=./data/recordings
RECORD_MAX_MB=300
