{
  "name": "grok-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Paper-trading bot for Solana memecoins on real market data (6-agent pipeline, PWA dashboard)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "replay": "tsx src/replay.ts",
    "record:fixtures": "tsx scripts/record-fixtures.ts",
    "icons": "node scripts/gen-icons.mjs",
    "stats": "tsx src/statsCli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
